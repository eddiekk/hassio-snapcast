#!/usr/bin/with-contenv bashio
# ==============================================================================
# Start the example service
# s6-overlay docs: https://github.com/just-containers/s6-overlay
# ==============================================================================

config=/etc/snapserver.conf

until [ -e /run/avahi-daemon/pid ]; do
  sleep 1s
done

bashio::log.info "Starting snapcast server..."

# Use the log level if set
if bashio::config.has_value "log_level"; then
    bashio::log.info "Setting log level to '$(bashio::config 'log_level')'"
    bashio::log.level "$(bashio::config 'log_level')"
fi

bashio::log.debug "Config: $(bashio::addon.config)"

echo "[stream]" > "${config}"
for stream in $(bashio::config 'streams.streams'); do
    echo "source = ${stream}" >> "${config}"
done

sampleformat=$(bashio::config 'sampleformat')

# Add DLNA Media Renderer source if enabled
if bashio::config.true 'enable_dlna_renderer'; then
    bashio::log.info "Enabling built-in DLNA Renderer source"
    echo "source = pipe:///share/snapfifo?&name=DLNA&disable_audio_cache=true&sampleformat=${sampleformat}" >> "${config}"
else
    bashio::log.info "Skipping built-in DLNA Renderer source (disabled via configuration)"
fi

# Add the Spotify source
device_name=$(bashio::config 'spotify_name')
spotify_auth=""
if bashio::config.has_value 'spotify_token'; then

    token=$(bashio::config 'spotify_token')
    spotify_auth="&access_token=${token}"
fi

librespot_options=""
if bashio::config.has_value 'librespot_options'; then
    raw_params=$(bashio::config 'librespot_options')
    raw_params="${raw_params//$'\r'/}"
    raw_params="${raw_params//$'\n'/}"
    raw_params="${raw_params#&}"
    if [[ -n "${raw_params}" ]]; then
        librespot_options="&${raw_params}"
    fi
fi

if bashio::config.true 'enable_spotify_source'; then
    bashio::log.info "Enabling built-in Spotify (librespot) source"
    echo "source = librespot:///usr/bin/librespot?name=Spotify&devicename="${device_name}"${spotify_auth}&disable_audio_cache=true&cache=/data/spot${librespot_options}" >> "${config}"
else
    bashio::log.warning "Built-in Spotify (librespot) source disabled via configuration"
fi

{
    echo "buffer = $(bashio::config 'buffer')"
    echo "codec = $(bashio::config 'codec')"
    echo "send_to_muted = $(bashio::config 'send_to_muted')"
    echo "sampleformat = $(bashio::config 'sampleformat')"
    echo "chunk_ms = $(bashio::config 'chunk_ms')"
    echo "[streaming_client]"
    echo "initial_volume = $(bashio::config 'initial_volume')"
    echo "[http]"
    echo "doc_root = /usr/share/snapweb"
} >> "${config}"

bashio::log.debug "SnapServer Config: $(cat ${config})"

# Configure snapweb
cat <<EOT > /usr/share/snapweb/config.js
"use strict";
let config = {
    baseUrl: (window.location.protocol === 'https:' ? 'wss://' : 'ws://') + window.location.host + window.location.pathname.replace(/\/$/, '')
}
EOT

## Run snapserver program
/usr/bin/snapserver -c /etc/snapserver.conf
